# 塔罗/占星/心灵陪伴应用 —— 环境变量示例
# 复制为 .env 并按需填写；本文件只放占位与说明，不含真实密钥。
# 完整默认值见 backend/config.py。

# ===== Gemini（主 LLM，必填） =====
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-3.1-flash-lite

# ===== 多 Provider LLM（前置/解读/记忆 三个 Agent 可独立选 provider）=====
# 不配任何一项 → 三个 Agent 全部沿用 Gemini 现状，行为零变化。
# DeepSeek / Kimi 均为 OpenAI 兼容 API，key 按 provider 配一次（同一家不重复填）。
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# KIMI_API_KEY=sk-...
# KIMI_BASE_URL=https://api.moonshot.cn/v1

# 每个 Agent：provider ∈ {gemini, deepseek, kimi}，model 为该 provider 下的模型名
# OPENING_PROVIDER=gemini      # gemini | deepseek | kimi
# OPENING_MODEL=gemini-3.1-flash-lite
# READING_PROVIDER=gemini
# READING_MODEL=gemini-3.1-flash-lite
# MEMORY_PROVIDER=gemini
# MEMORY_MODEL=gemini-2.5-flash
#
# 示例：DeepSeek 跑记忆 Agent（笔记摘要，纯 JSON，零 FC 风险）
#   MEMORY_PROVIDER=deepseek
#   MEMORY_MODEL=deepseek-chat
# 示例：Kimi 跑解读 Agent（含 function calling，需真实联调验证工具调用可靠性）
#   READING_PROVIDER=kimi
#   READING_MODEL=moonshot-v1-8k

# ===== 鉴权 =====
# SECRET_KEY=change-me-in-production
# ACCESS_TOKEN_EXPIRE_MINUTES=86400

# ===== 限流 =====
# GUEST_DAILY_MESSAGE_LIMIT=15
# USER_DAILY_MESSAGE_LIMIT=50

# ===== 占星 API =====
# ASTROLOGY_ACCESS_TOKEN=your-astrology-api-token

# ===== 后台管理（未配置则 /api/admin 整体 404） =====
# ADMIN_PASSWORD=
# ADMIN_TOKEN_EXPIRE_MINUTES=1440

# ===== 站点地址（支付回调/跳转拼接用） =====
# PUBLIC_BASE_URL=http://localhost:8000
# FRONTEND_BASE_URL=http://localhost:5173

# ===== 支付（真实渠道接入时才需要，模拟支付无需配置） =====
# PAYMENTS_ALLOW_MOCK=true
# ALIPAY_APP_ID=
# ALIPAY_APP_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY=
# WECHAT_APP_ID=
# WECHAT_MCH_ID=
# WECHAT_API_V3_KEY=
# WECHAT_CERT_SERIAL=
# WECHAT_MERCHANT_PRIVATE_KEY=

# ===== 开场相位（前置 Agent 澄清轮上限/超时） =====
# OPENING_FORCE_BRIEF_AFTER_USER_MSGS=3
# OPENING_HARD_EXIT_AFTER_USER_MSGS=5
# OPENING_GREETING_TIMEOUT_SECONDS=8

# ===== 数据存储路径（一般无需覆盖） =====
# TAROT_DB_FILE=backend/data/app.db
