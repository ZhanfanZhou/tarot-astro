# 塔罗/占星/心灵陪伴应用 —— 环境变量示例
# 复制为 .env 并按需填写；本文件只放占位与说明，不含真实密钥。
# 完整默认值见 backend/config.py。

# ===== LLM 密钥 =====
# GEMINI_API_KEY=your-gemini-api-key
# DeepSeek / Kimi 均为 OpenAI 兼容 API，key 按 provider 配一次（同一家不重复填）。
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# KIMI_API_KEY=sk-...
# KIMI_BASE_URL=https://api.moonshot.cn/v1     # 国内站；国际站是 https://api.moonshot.ai/v1

# ===== 三个 Agent 各自的 provider + model =====
# provider ∈ {gemini, deepseek, kimi}；model 必须是该 provider 下的模型名。
# 两行一组，换 provider 就要一起换 model。全不配 → 三个都走 Gemini。
# OPENING_PROVIDER=gemini
# OPENING_MODEL=gemini-3.1-flash-lite
# READING_PROVIDER=gemini
# READING_MODEL=gemini-3.1-flash-lite
# MEMORY_PROVIDER=gemini
# MEMORY_MODEL=gemini-2.5-flash
#
# 三个 Agent 对模型的要求不同，选型前先看这里（核对于 2026-09）：
#   memory  只出 JSON，不调工具 —— 任何模型都行，挑便宜的
#   reading 要工具调用（auto 即可）—— 三家现役模型都支持
#   opening 同样要工具调用，且要读得懂一段对话该不该交单 —— 太小的模型会一直追问
#
# 示例：DeepSeek 跑全部三个（当前实测可用）
#   OPENING_PROVIDER=deepseek   OPENING_MODEL=deepseek-flash
#   READING_PROVIDER=deepseek   READING_MODEL=deepseek-flash
#   MEMORY_PROVIDER=deepseek    MEMORY_MODEL=deepseek-flash
#   （另有 deepseek-v4-pro；旧名 deepseek-chat / deepseek-reasoner 已退役）
# 示例：Kimi 跑解读与记忆（不需要强制调用），开场留给 Gemini / DeepSeek
#   READING_PROVIDER=kimi       READING_MODEL=kimi-k3
#   MEMORY_PROVIDER=kimi        MEMORY_MODEL=kimi-k2.6
#
# 以上都可以在管理页「模型」页签在线改，改完下一次对话即生效，不必动这个文件。

# ===== 鉴权 =====
# SECRET_KEY=change-me-in-production
# ACCESS_TOKEN_EXPIRE_MINUTES=86400

# ===== 限流 =====
# GUEST_DAILY_MESSAGE_LIMIT=15
# USER_DAILY_MESSAGE_LIMIT=50

# ===== 占星 API =====
# ASTROLOGY_ACCESS_TOKEN=your-astrology-api-token

# ===== 后台管理（未配置则 /api/admin 整体 404） =====
# ADMIN_PASSWORD=
# ADMIN_TOKEN_EXPIRE_MINUTES=1440

# ===== 站点地址（支付回调/跳转拼接用） =====
# PUBLIC_BASE_URL=http://localhost:8000
# FRONTEND_BASE_URL=http://localhost:5173

# ===== 支付（真实渠道接入时才需要，模拟支付无需配置） =====
# PAYMENTS_ALLOW_MOCK=true
# ALIPAY_APP_ID=
# ALIPAY_APP_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY=
# WECHAT_APP_ID=
# WECHAT_MCH_ID=
# WECHAT_API_V3_KEY=
# WECHAT_CERT_SERIAL=
# WECHAT_MERCHANT_PRIVATE_KEY=

# ===== 开场相位（开场白超时；交单时机全在 opening_system.md 里） =====
# OPENING_GREETING_TIMEOUT_SECONDS=8

# ===== 数据存储路径（一般无需覆盖） =====
# TAROT_DB_FILE=backend/data/app.db
